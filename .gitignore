# ============================================================
# ANTIGRAVITY — .gitignore
# Python + FastAPI + Flutter
# ============================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables — NEVER commit secrets
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Python distribution / packaging
dist/
build/
*.egg-info/
*.egg
*.whl
pip-log.txt
pip-delete-this-directory.txt

# Testing / Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# MyPy / type checking
.mypy_cache/

# Jupyter
.ipynb_checkpoints/

# Flutter / Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
*.iml
ios/Pods/
ios/.symlinks/
android/.gradle/
android/local.properties

# Logs
*.log
